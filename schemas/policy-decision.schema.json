{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Policy Decision",
  "type": "object",
  "required": ["decision", "reasons", "rule_ids"],
  "properties": {
    "decision": {
      "enum": ["allowed", "approval_required", "blocked"]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rule_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_approval_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "object"
    }
  }
}
