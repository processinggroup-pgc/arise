{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARISE Work Item",
  "type": "object",
  "required": [
    "title",
    "problem_statement",
    "target_user",
    "desired_behavior",
    "acceptance_criteria",
    "data_classification"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 3
    },
    "problem_statement": {
      "type": "string",
      "minLength": 10
    },
    "target_user": {
      "type": "string",
      "minLength": 2
    },
    "desired_behavior": {
      "type": "string",
      "minLength": 10
    },
    "data_classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "personal",
        "financial",
        "health",
        "authentication",
        "trade_secret"
      ]
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["given", "when", "then"],
        "properties": {
          "given": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "then": {
            "type": "string"
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
