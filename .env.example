# Application
NODE_ENV=development

# Supabase — public (safe for browser via NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Supabase — server only (never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres — pooler (app queries, most integration tests)
# URL-encode special characters in the password (e.g. [ ] $ → %5B %5D %24)
DATABASE_URL=postgresql://postgres.your-project-ref:your-url-encoded-password@aws-0-us-east-2.pooler.supabase.com:6543/postgres

# Postgres — direct connection (migrations, RLS validation)
DIRECT_URL=postgresql://postgres:your-url-encoded-password@db.your-project-ref.supabase.co:5432/postgres

# Anthropic — server only (primary market research dossier)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI — server only (dual-AI comparison / ChatGPT pass)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o

# Vercel — server only (Step 5 platform connect + deploy)
# Required: token + team ID. Each initiative gets its own Vercel project.
# Link GitHub (Project → Settings → Git) and Supabase (Settings → Integrations)
# on each Vercel project; the Supabase integration syncs POSTGRES_URL and keys.
# Pull synced vars locally with: npx vercel env pull .env.local
VERCEL_TOKEN=your-vercel-access-token
VERCEL_TEAM_ID=team_your-team-id
# Optional: link GitHub when creating each initiative project via the Vercel API
VERCEL_GIT_REPO=processinggroup-pgc/arise
# Optional: monorepo app root for Vercel builds
# VERCEL_ROOT_DIRECTORY=apps/web
# VERCEL_PROJECT_ID=prj_your-project-id

# Resend — server only (Step 5 email)
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=hello@yourdomain.com
